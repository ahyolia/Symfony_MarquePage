{% extends 'Livres/base.html.twig' %}

{% block title %}Livres | Liste{% endblock %}
{% block section_title %}Liste complete des livres{% endblock %}
{% block section_subtitle %}Selectionnez un livre pour afficher sa page de details.{% endblock %}

{% block livre_content %}
    <p>
        <a href="{{ path('livres_ajout') }}">Ajouter un livre</a>
    </p>
    <p>
        <a href="{{ path('auteur_ajout') }}">Ajouter un auteur</a>
    </p>

    {% if livres %}
        <table>
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Auteur</th>
                    <th>Annee</th>
                </tr>
            </thead>
            <tbody>
                {% for livre in livres %}
                    <tr class="livre-row"
                        tabindex="0"
                        role="link"
                        onclick="window.location.href='{{ path('livres_details', {'id': livre.id}) }}'"
                        onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); window.location.href='{{ path('livres_details', {'id': livre.id}) }}'; }">
                        <td>{{ livre.titre }}</td>
                        <td>{{ livre.auteur.prenom }} {{ livre.auteur.nom }}</td>
                        <td>{{ livre.annee|date('Y') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>Aucun livre trouvé.</p>
    {% endif %}
{% endblock %}
