{% extends 'MarquePage/base.html.twig' %}

{% block title %}Marque-pages | Detail{% endblock %}
{% block section_title %}Detail d'un marque-page{% endblock %}
{% block section_subtitle %}Visualisez toutes les informations du lien.{% endblock %}

{% block marque_page_content %}
    {% if marquepage %}
        <table>
            <thead>
                <tr>
                    <th>Libelle</th>
                    <th>Valeur</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>ID</td>
                    <td>{{ marquepage.id }}</td>
                </tr>
                <tr>
                    <td>URL</td>
                    <td><a href="{{ marquepage.URL }}" target="_blank" rel="noopener noreferrer">{{ marquepage.URL }}</a></td>
                </tr>
                <tr>
                    <td>Date de creation</td>
                    <td>{{ marquepage.dateCreation|date('d/m/Y') }}</td>
                </tr>
                <tr>
                    <td>Commentaire</td>
                    <td>{{ marquepage.commentaire }}</td>
                </tr>
                <tr>
                    <td>Mots cles</td>
                    <td>
                        {% if marquepage.motsCles is not empty %}
                            {% for motCle in marquepage.motsCles %}
                                {{ motCle.nom }}{% if not loop.last %}<br>{% endif %}
                            {% endfor %}
                        {% else %}
                            Aucun mot-clé associe.
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>
        <p><a href="{{ path('marquepage_modifier', {'id': marquepage.id}) }}">Modifier ce marque-page</a></p>
        <p><a href="{{ path('marquepage_index') }}">Retour vers l'index</a></p>
    {% else %}
        <p>Aucun marque-page trouve.</p>
    {% endif %}
{% endblock %}