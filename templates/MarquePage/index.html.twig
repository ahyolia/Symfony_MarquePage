{% extends 'MarquePage/base.html.twig' %}

{% block title %}Marque-pages | Liste{% endblock %}
{% block section_title %}Liste complete des marque-pages{% endblock %}
{% block section_subtitle %}Cliquez sur un marque-page pour ouvrir sa page de details.{% endblock %}

{% block marque_page_content %}
    <p><a href="{{ path('marquepage_ajout') }}">Ajouter un marque-page</a></p>

    {% if marquepages %}
        <table>
            <thead>
                <tr>
                    <th>URL</th>
                    <th>Commentaire</th>
                </tr>
            </thead>
            <tbody>
                {% for page in marquepages %}
                    <tr class="marquepage-row" onclick="window.location='{{ path('marquepage_details', {'id': page.id}) }}';" onkeydown="if(event.key === 'Enter' || event.key === ' ') { event.preventDefault(); window.location='{{ path('marquepage_details', {'id': page.id}) }}'; }" role="link" tabindex="0" aria-label="Voir les details du marque-page {{ page.id }}">
                        <td>{{ page.URL }}</td>
                        <td>{{ page.commentaire }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>Aucun marque-page trouve.</p>
    {% endif %}
{% endblock %}